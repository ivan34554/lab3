# Скопируйте в .env и подставьте свои значения (.env в git не попадает).

# Пароль ограниченного пользователя БД podcast_app, под которым работает приложение:
DB_PASSWORD=change_me
# Пароль владельца БД podcast_owner (нужен только контейнеру PostgreSQL для создания схемы):
DB_OWNER_PASSWORD=change_me_too

# Необязательно (значения по умолчанию):
# DB_URL=jdbc:postgresql://localhost:5432/podcasts
# DB_USERNAME=podcast_app
